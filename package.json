{
  "name": "vedos",
  "version": "1.0.0",
  "description": "Film Negative to Positive RAW Converter",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -n vite,electron \"vite --config vite.config.ts\" \"tsc -p tsconfig.electron.json && electron .\"",
    "dev:vite": "vite --config vite.config.ts",
    "dev:electron": "tsc -p tsconfig.electron.json && electron .",
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.electron.json",
    "build:renderer": "vite build --config vite.config.ts",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:backend": "bash scripts/build-backend.sh",
    "build:all": "npm run build && npm run build:backend",
    "package": "npm run build:all && electron-builder",
    "package:win": "npm run build:all && electron-builder --win",
    "package:mac": "npm run build:all && electron-builder --mac",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit"
  },
  "keywords": ["electron", "photography", "film", "negative", "raw"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^9.2.1",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
